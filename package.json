{
  "name": "cinedirect",
  "version": "2.0.0",
  "private": true,
  "description": "CineDirect - Movie/TV Show Search with Direct Download Links",
  "workspaces": [
    "client",
    "server",
    "worker",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\" \"npm run dev:worker\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:worker": "npm run dev --workspace=worker",
    "build": "npm run build --workspaces --if-present",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:worker": "npm run build --workspace=worker",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=client",
    "test:a11y": "npm run test:a11y --workspace=client",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "deploy:client": "npm run deploy --workspace=client",
    "deploy:worker": "npm run deploy --workspace=worker",
    "deploy:server": "npm run deploy --workspace=server",
    "clean": "rimraf client/dist server/dist worker/dist shared/dist"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "rimraf": "^5.0.5",
    "terser": "^5.51.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.2.0"
}
