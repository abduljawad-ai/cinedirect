{
  "name": "cinedirect-relay",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "esbuild src/index.ts --bundle --outdir=dist --format=esm --platform=browser --target=es2022",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext ts --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240320.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "esbuild": "^0.28.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.130.0",
    "@types/node": "^22.0.0"
  }
}
